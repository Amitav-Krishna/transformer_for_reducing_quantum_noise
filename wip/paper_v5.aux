\newlabel{fig:norm-vs-unnorm}{{3}{4}{Validation loss curves for the 5-qubit MLP with and without Frobenius normalization. Normalization enables faster convergence and a 25\% lower final loss}{figure.caption.3}{}}
\newlabel{tab:org2fb6afb}{{I}{4}{5-qubit model performance with Frobenius normalization. Both models use identical patch tokenization (\(4\times 4\) patches, 64 tokens) and matched parameter counts}{table.caption.5}{}}
\newlabel{tab:orgc54eb0e}{{II}{4}{Capacity ablations on unnormalized 5-qubit data. Larger models perform worse, confirming an optimization pathology}{table.caption.6}{}}
\newlabel{fig:val-loss-5q}{{4a}{5}{5-qubit models}{figure.caption.4}{}}
\newlabel{sub@fig:val-loss-5q}{{a}{5}{5-qubit models}{figure.caption.4}{}}
\newlabel{fig:val-loss-8q}{{4b}{5}{8-qubit models (y-axis truncated)}{figure.caption.4}{}}
\newlabel{sub@fig:val-loss-8q}{{b}{5}{8-qubit models (y-axis truncated)}{figure.caption.4}{}}
\newlabel{fig:val-loss-curves}{{4}{5}{Validation loss curves for unnormalized (dashed) and normalized (solid) models. (a) 5-qubit models show a clear separation between normalized and unnormalized training. (b) 8-qubit models reveal that normalized models steadily improve while unnormalized models plateau}{figure.caption.4}{}}
\newlabel{tab:org2095ac3}{{III}{5}{8-qubit scaling results with Frobenius normalization. Despite the exponentially harder task (baseline 0.006), both models achieve more than 3 times improvement}{table.caption.7}{}}
